# Server-only PostgreSQL credential; apply supabase/migrations explicitly before data requests.
DATABASE_URL=postgresql://postgres:replace_me@127.0.0.1:54322/postgres
# Per-process ceilings; budget API and worker pools together against the database limit.
DATABASE_POOL_SIZE=8
DATABASE_CONTROL_POOL_SIZE=2
DATABASE_POOL_TIMEOUT=5
DATABASE_LOCK_TIMEOUT_MS=3000
DATABASE_STATEMENT_TIMEOUT_MS=30000
CORS_ORIGINS=["http://localhost:3000"]
APP_ENV=production
DEMO_MODE=false
GENERATION_ENABLED=false
GENERATION_LIMITS_ENABLED=true
GENERATION_CONCURRENCY=2
GENERATION_DAILY_LIMIT=30
API_REQUESTS_PER_MINUTE=120
JOB_ATTEMPT_LIMIT=2
MODEL_TIMEOUT_SECONDS=60
QUIZ_MODEL=anthropic:claude-sonnet-5-5
# Set the appropriate ANTHROPIC_API_KEY or OPENROUTER_API_KEY privately; never commit real values.
# Optional VISUAL_MODEL uses the same model-name format as QUIZ_MODEL.
# Search by meaning over uploaded books. Needs the provider's key (OPENROUTER_API_KEY or OPENAI_API_KEY);
# leave EMBEDDING_MODEL empty to use keyword search only. Supported providers: openrouter:, openai:.
EMBEDDING_MODEL=openrouter:openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=51
# Illustrations: pictures from an OpenRouter image model (needs OPENROUTER_API_KEY), stored in the lesson.
# One image model call per picture, no chat model; about $0.03 each with the default model, so they are capped per lesson.
ILLUSTRATIONS_ENABLED=false
# ILLUSTRATION_MODEL=google/gemini-3.1-flash-lite-image
# ILLUSTRATIONS_PER_LESSON=2
# Chat memory: one SQLite file holding every player's saved conversations (kept per player id).
MEMORY_DB_PATH=memory.db
# Homes, wallets and friends: one SQLite file (kept per player id).
HOME_DB_PATH=home.db
# Child safety (learning_service/safety.py). The learners are school students aged 10-18.
# AUDIENCE_MAX_AGE: the oldest age the content rules are relaxed for. The backend cannot verify a learner age,
# so someone who types 40 still gets the 18-and-under rules. Default 18; raise it only for adult-only use.
# AUDIENCE_MAX_AGE=18
# SAFETY_MODEL checks what was written, same format as QUIZ_MODEL. Empty means use QUIZ_MODEL.
# SAFETY_MODEL=

# Optional deterministic saved-diagram game (install Node/Chromium and migration 008 first).
DIAGRAM_ASSEMBLY_ENABLED=false
DIAGRAM_NODE_EXECUTABLE=node
DIAGRAM_RENDER_TIMEOUT=20
DIAGRAM_RENDER_CONCURRENCY=1
DIAGRAM_BROWSER_SANDBOX=true
# DIAGRAM_BROWSER_EXECUTABLE=/path/to/managed/chromium

# Friend presence and lobby invitations
PRESENCE_TTL_SECONDS=90
GAME_INVITE_TTL_SECONDS=600
GAME_INVITES_PER_HOUR=30
