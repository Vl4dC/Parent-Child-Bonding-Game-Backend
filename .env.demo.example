# Ephemeral application storage. No login, tokens or Supabase Auth credentials.
APP_ENV=development
DEMO_MODE=true
CORS_ORIGINS=["http://localhost:3000"]
GENERATION_ENABLED=false

# Friend presence and lobby invitations
PRESENCE_TTL_SECONDS=90
GAME_INVITE_TTL_SECONDS=600
GAME_INVITES_PER_HOUR=30

# /api/social only: use the exact Clerk issuer, plus signed player_id and username session claims.
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_AUTHORIZED_PARTIES=["http://localhost:3000"]
