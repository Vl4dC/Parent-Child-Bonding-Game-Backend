# Local demo: copy this file to `.env` (cp .env.demo.example .env), then fill in the values marked REQUIRED.
# Ephemeral application storage. No Supabase Auth credentials.
APP_ENV=development
DEMO_MODE=true
CORS_ORIGINS=["http://localhost:3000"]
GENERATION_ENABLED=false

# REQUIRED: sign-in. Every /api request carries a Clerk session token, and this is how the server checks it.
# Set it to your Clerk "Frontend API URL" (shown on the API keys page of the Clerk dashboard; it is also the `iss`
# claim of a session token). The server then reads Clerk's public keys from <issuer>/.well-known/jwks.json.
# Without it every /api request is a 503. The session token also needs a `player_id` claim: see the step-by-step in
# .env.example, which also lists the other JWT_* settings.
JWT_ISSUER=https://your-instance.clerk.accounts.dev

# Friend presence and lobby invitations
PRESENCE_TTL_SECONDS=90
GAME_INVITE_TTL_SECONDS=600
GAME_INVITES_PER_HOUR=30
