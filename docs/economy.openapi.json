{
  "openapi": "3.1.0",
  "info": {
    "title": "Coins, quests and wardrobe API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/me/coins/claim-duel": {
      "post": {
        "tags": [
          "Economy"
        ],
        "summary": "Claim Duel",
        "operationId": "claim_duel_api_me_coins_claim_duel_post",
        "parameters": [
          {
            "name": "X-Player-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Optional player UUID for state selection, not authentication.",
              "default": "00000000-0000-4000-8000-000000000001",
              "title": "X-Player-Id"
            },
            "description": "Optional player UUID for state selection, not authentication."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DuelClaim"
              },
              "examples": {
                "local": {
                  "summary": "Collect a same-device duel reward",
                  "value": {
                    "tournament_id": "<tournament id>"
                  }
                },
                "match": {
                  "summary": "Collect my parent-child match reward",
                  "value": {
                    "match_id": "<match id>"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoinsOut"
                }
              }
            }
          },
          "429": {
            "description": "Request or generation limit reached"
          },
          "503": {
            "description": "Storage or generation unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/coins/claim-participation": {
      "post": {
        "tags": [
          "Economy"
        ],
        "summary": "Claim Participation",
        "description": "20 coins once per completed game and participant, regardless of score. No duplicate duel bonus.",
        "operationId": "claim_participation_api_me_coins_claim_participation_post",
        "parameters": [
          {
            "name": "X-Player-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Optional player UUID for state selection, not authentication.",
              "default": "00000000-0000-4000-8000-000000000001",
              "title": "X-Player-Id"
            },
            "description": "Optional player UUID for state selection, not authentication."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParticipationClaim"
              },
              "examples": {
                "quiz": {
                  "summary": "Collect 20 coins after answering the whole quiz",
                  "value": {
                    "source": "quiz",
                    "id": "<quiz id>"
                  }
                },
                "match": {
                  "summary": "Collect participation coins after a match ends",
                  "value": {
                    "source": "match",
                    "id": "<match id>"
                  }
                },
                "race": {
                  "summary": "Collect coins after participating in a diagram race",
                  "value": {
                    "source": "diagram_race",
                    "id": "<race id>"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoinsOut"
                }
              }
            }
          },
          "429": {
            "description": "Request or generation limit reached"
          },
          "503": {
            "description": "Storage or generation unavailable"
          },
          "404": {
            "description": "Game unavailable to this player"
          },
          "409": {
            "description": "Game incomplete or player did not participate"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/equipment/{slot}": {
      "put": {
        "tags": [
          "Economy"
        ],
        "summary": "Equip",
        "operationId": "equip_api_me_equipment__slot__put",
        "parameters": [
          {
            "name": "slot",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "look",
                "pet",
                "top",
                "jacket",
                "bottom",
                "shoes",
                "hat",
                "glasses",
                "earrings",
                "tie"
              ],
              "type": "string",
              "title": "Slot"
            }
          },
          {
            "name": "X-Player-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Optional player UUID for state selection, not authentication.",
              "default": "00000000-0000-4000-8000-000000000001",
              "title": "X-Player-Id"
            },
            "description": "Optional player UUID for state selection, not authentication."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EquipIn"
              },
              "examples": {
                "wear": {
                  "summary": "Equip an owned top in the top slot",
                  "value": {
                    "item_id": "top.navy"
                  }
                },
                "remove": {
                  "summary": "Unequip the selected slot",
                  "value": {}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryOut"
                }
              }
            }
          },
          "429": {
            "description": "Request or generation limit reached"
          },
          "503": {
            "description": "Storage or generation unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
