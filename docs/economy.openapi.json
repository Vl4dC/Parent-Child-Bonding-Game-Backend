    "/api/tournament/{tournament_id}/duel": {
      "post": {
        "tags": [
          "Tournament"
        ],
        "summary": "Submit Duel",
        "description": "Freeze both local players' answers before revealing either result. Identical replays are free.\nUse /api/me/coins/claim-duel afterwards to collect player 0's reward.",
        "operationId": "submit_duel_api_tournament__tournament_id__duel_post",
        "parameters": [
          {
            "name": "tournament_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "The `id` returned by `POST /api/tournament`",
              "title": "Tournament Id"
            },
            "description": "The `id` returned by `POST /api/tournament`"
          },
          {
            "name": "X-Player-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Optional player UUID for state selection, not authentication.",
              "default": "00000000-0000-4000-8000-000000000001",
              "title": "X-Player-Id"
            },
            "description": "Optional player UUID for state selection, not authentication."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DuelIn"
              },
              "examples": {
                "two_players": {
                  "summary": "Both players answer a two-question duel",
                  "value": {
                    "answers": [
                      [
                        1,
                        0
                      ],
                      [
                        0,
                        1
                      ]
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DuelOut"
                }
              }
            }
          },
          "429": {
            "description": "Request or generation limit reached"
          },
          "503": {
            "description": "Storage or generation unavailable"
          },
          "404": {
            "description": "Unknown or unowned id. Ephemeral demo records also disappear on restart.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Nothing to practise, review required, stale state, or conflicting replay.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input, or a request the book doesn't cover, or content the child-safety check held back because it isn't suitable for the learner's age. The response never repeats the unsafe text.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DuelClaim": {
        "properties": {
          "tournament_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Tournament Id"
          },
          "match_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Match Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "DuelClaim"
      },
      "CoinsOut": {
        "properties": {
          "coins": {
            "type": "integer",
            "title": "Coins",
            "description": "The balance now"
          },
          "credited": {
            "type": "integer",
            "title": "Credited",
            "description": "Coins added by this call (0 if all were paid before)"
          }
        },
        "type": "object",
        "required": [
          "coins",
          "credited"
        ],
        "title": "CoinsOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "ParticipationClaim": {
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "quiz",
              "tournament",
              "match",
              "diagram_race"
            ],
            "title": "Source"
          },
          "id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "id"
        ],
        "title": "ParticipationClaim"
      },
      "EquipIn": {
        "properties": {
          "item_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Item Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "item_id"
        ],
        "title": "EquipIn"
      },
      "InventoryOut": {
        "properties": {
          "owned": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Owned"
          },
          "equipped": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Equipped"
          }
        },
        "type": "object",
        "required": [
          "owned",
          "equipped"
        ],
        "title": "InventoryOut"
      },
      "QuestsOut": {
        "properties": {
          "timezone": {
            "type": "string",
            "title": "Timezone",
            "default": "Europe/Berlin"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/QuestOut"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "QuestsOut"
      },
      "QuestOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "kind": {
            "type": "string",
            "enum": [
              "daily",
              "weekly"
            ],
            "title": "Kind"
          },
          "period": {
            "type": "string",
            "title": "Period"
          },
          "resets_at": {
            "type": "string",
            "format": "date-time",
            "title": "Resets At"
          },
          "progress": {
            "type": "integer",
            "title": "Progress"
          },
          "target": {
            "type": "integer",
            "title": "Target"
          },
          "reward": {
            "type": "integer",
            "title": "Reward"
          },
          "claimed": {
            "type": "boolean",
            "title": "Claimed"
          },
          "claimable": {
            "type": "boolean",
            "title": "Claimable"
          }
        },
        "type": "object",
        "required": [
