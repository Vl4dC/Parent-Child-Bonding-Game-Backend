  "components": {
    "schemas": {
      "AnswerInput": {
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Index"
          },
          "choice": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Choice"
          },
          "expected_answered": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Answered"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "index",
          "choice",
          "expected_answered"
        ],
        "title": "AnswerInput"
      },
      "AnswerResponse": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "recorded_choice": {
            "type": "integer",
            "title": "Recorded Choice"
          },
          "feedback": {
            "$ref": "#/components/schemas/CheckOut"
          },
          "progress": {
            "$ref": "#/components/schemas/app__quiz_practice__Progress"
          }
        },
        "type": "object",
        "required": [
          "index",
          "recorded_choice",
          "feedback",
          "progress"
        ],
        "title": "AnswerResponse"
      },
      "AttemptPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AttemptSummary"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "AttemptPage"
      },
      "AttemptSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "question_set_id": {
            "type": "string",
            "title": "Question Set Id"
          },
          "lesson_id": {
            "type": "string",
            "title": "Lesson Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "not_started",
              "in_progress",
              "ready_to_finish",
              "completed"
            ],
            "title": "Status"
          },
          "answered": {
            "type": "integer",
            "title": "Answered"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "score": {
            "type": "integer",
            "title": "Score"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "question_set_id",
          "lesson_id",
          "title",
          "parent_id",
          "status",
          "answered",
          "total",
          "score",
          "completed_at"
        ],
        "title": "AttemptSummary"
      },
      "AuthorQuestion": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "question": {
            "type": "string",
            "title": "Question"
          },
          "options": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Options"
          },
          "answer_index": {
            "type": "integer",
            "title": "Answer Index"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          }
        },
        "type": "object",
        "required": [
          "index",
          "type",
          "question",
          "options",
          "answer_index",
          "explanation"
        ],
        "title": "AuthorQuestion"
      },
      "AuthorReview": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "question_set_id": {
            "type": "string",
            "title": "Question Set Id"
          },
          "lesson_id": {
            "type": "string",
            "title": "Lesson Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
