  "paths": {
    "/api/quiz/{quiz_id}/progress": {
      "get": {
        "tags": [
          "Quiz practice"
        ],
        "summary": "Progress",
        "description": "Resume from saved first answers; never return unanswered keys or explanations.",
        "operationId": "progress_api_quiz__quiz_id__progress_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "quiz_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "title": "Quiz Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/app__quiz_practice__Progress"
                }
              }
            }
          },
          "401": {
            "description": "Verified identity required"
          },
          "404": {
            "description": "Quiz absent or owned by another account"
          },
          "409": {
            "description": "Stale state, conflicting retry, or incomplete attempt"
          },
          "429": {
            "description": "Request limit reached"
          },
          "503": {
            "description": "Storage unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
